@startuml
!include <C4/C4_Context>
title System Context — Tracer Spec Workflow
Person(contributor, "Project Contributor", "Records and reviews changes")
System_Ext(agent, "Coding Agent", "Runs the workflow skills")
System(tracer, "Tracer Spec Workflow", "Requirement-anchored change workflow over a traceable graph")
System_Ext(git, "Git Host", "Stores the graph and templates")
System_Ext(tracker, "Issue Tracker", "Owns ticket state and estimates (optional)")
