Rel(contributor, tracer, "authors changes with")
Rel(agent, tracer, "drives the workflow with")
Rel(tracer, git, "reads and writes the graph in")
Rel(tracer, tracker, "associates items with", "optional")
Rel(tracer, kroki, "renders diagrams through", "build time")
@enduml
